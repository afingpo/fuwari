---
interface Props {
  path: string
}
const { path } = Astro.props

const twikooConfig = {
  envId: 'https://twikoo.iluc.cn/.netlify/functions/twikoo',
  lang: 'zh-CN',
  el: '#tcomment',
  path: path,
}

---

<div id="tcomment"></div>

<script 
  src="https://registry.npmmirror.com/twikoo/1.7.13/files/dist/twikoo.min.js" 
  integrity="sha384-tolmjgXFAyQqyrcD+IC55sJypZy4Khcl8sD8ricVii2yGfrLCf0kG1zp3u00K2fp"
  crossorigin="anonymous"
></script>

<script is:inline define:vars={{ twikooConfig }}>
  function initTwikoo() {
    const el = document.querySelector('#tcomment');
    if (!el) return;

    // 如果 twikoo 已加载，直接初始化
    if (window.twikoo) {
      window.twikoo.init(twikooConfig);
      return;
    }

    // 未加载则轮询等待（最多 5 秒）
    let retries = 0;
    const timer = setInterval(() => {
      if (window.twikoo) {
        clearInterval(timer);
        window.twikoo.init(twikooConfig);
      } else if (++retries > 50) {
        clearInterval(timer);
      }
    }, 100);
  }

  initTwikoo();
  document.addEventListener('astro:after-swap', initTwikoo);
</script>
