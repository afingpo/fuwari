---
import { getEntry } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
    class?: string;
    style?: string;
}
const { class: className, style } = Astro.props;

const noticePost = await getEntry("spec", "notice");
const { html = "" } = (noticePost?.data || {}) as any;
---

<WidgetLayout name="公告" id="notice" class={className} style={style}>
    <Markdown class="text-sm text-neutral-500">
        <Fragment set:html={html} />
    </Markdown>
</WidgetLayout>
