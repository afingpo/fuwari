---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

// const commitHash = import.meta.env.PUBLIC_COMMIT_HASH || 'unknown'
const commitHash = import.meta.env.VERCEL_GIT_COMMIT_SHA || 
                   import.meta.env.PUBLIC_COMMIT_HASH || 
                   'unknown'

const buildDate = new Date().toISOString()
const displayHash = commitHash ? commitHash.slice(0, 7) : 'unknown'

---

<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(from_var(--primary)_85%_0.01_h)] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
		&copy; <span id="copyright-year">2025 - {currentYear}</span> <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://afingpo.top">{profileConfig.name}</a>，采用
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> 许可
		<br>
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS订阅</a> /
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>网站地图</a> /
		<a class="transition link text-[var(--primary)] font-medium" href="#" id="open_preferences_center">更新您的Cookie</a>
		<br>
		由
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> 与
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>构建本站页面
		<br>
		本站代码由Codeberg托管且
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://codeberg.org/afingpo/fuwari">已开源</a>
		<a class="transition link text-black/30 dark:text-white/30 hover:text-[var(--primary)] text-xs ml-1" target="_blank" href={`https://codeberg.org/afingpo/fuwari/commit/${commitHash}`}>({commitHash} @ {buildDate})</a>
		<br>
        <div class="transition link text-[var(--primary)] font-medium inline-flex items-center gap-2">
			<a href="https://icp.gov.moe/?keyword=20261267" target="_blank">萌ICP备20261267号</a>
			<span class="text-black/30 dark:text-white/30">|</span>
			<a href="https://icp.redcha.cn/beian/ICP-2026060365.html" title="茶ICP备2026060365号" target="_blank">茶ICP备2026060365号</a>
			<span class="text-black/30 dark:text-white/30">|</span>
			<a href="https://solsynth.dev/zh/icp/202600006" title="羝ICP备202600006号" target="_blank">羝ICP备202600006号</a>
			<span class="text-black/30 dark:text-white/30">|</span>
			<a href="https://fakeicp.top/query.html?number=1202611" title="假ICP备1202611号" target="_blank">假ICP备1202611号</a>
        </div>
    </div>
</div>
