---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import type { NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

// 预设链接枚举
enum LinkPreset {
    Home = 0,
    Archive = 1,
    About = 2,
    Links = 3,
    Bangumi = 4,
    Chronicle = 5,
}

const className = Astro.props.class;

// 预设链接：枚举 → i18n 名称 + URL
const linkPresets: { [key in LinkPreset]: NavBarLink } = {
    [LinkPreset.Home]:      { name: i18n(I18nKey.home),      url: "/" },
    [LinkPreset.Archive]:   { name: i18n(I18nKey.archive),   url: "/archive/" },
    [LinkPreset.Bangumi]:   { name: i18n(I18nKey.bangumi),   url: "/bangumi/" },
    [LinkPreset.Chronicle]: { name: i18n(I18nKey.chronicle), url: "/chronicle/" },
    [LinkPreset.Links]:     { name: i18n(I18nKey.links),     url: "/links/" },
    [LinkPreset.About]:     { name: i18n(I18nKey.about),     url: "/about/" },
};

// 导航链接配置
const navLinks: (LinkPreset | NavBarLink)[] = [
    LinkPreset.Home,
    LinkPreset.Archive,
    LinkPreset.Bangumi,
    LinkPreset.Chronicle,
    LinkPreset.Links,
    LinkPreset.About,
    {
        name: "开往",
        url: "https://www.travellings.cn/go.html",
        external: true,
    },
];

// 解析链接：枚举转实际数据
const links: NavBarLink[] = navLinks.map((item) => {
    if (typeof item === "number") {
        return linkPresets[item];
    }
    return item;
});
---

<nav id="navbar" class:list={[
    className,
    "z-50 onload-animation relative h-[3.75rem] bg-[var(--card-bg)] border-b border-black/5 dark:border-white/5 shadow-sm"
]}>
    <div class="max-w-[var(--page-width)] mx-auto h-full flex items-center justify-between px-6">
        <div class="flex items-center h-full">
            <a href={url('/')} class="btn-plain scale-animation rounded-none h-10 px-4 font-bold active:scale-95 flex items-center">
                <div class="flex flex-row text-black/90 dark:text-white/90 items-center text-md">
                    <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mr-2" />
                    <span class="hidden sm:block">{siteConfig.title}</span>
                </div>
            </a>

            <div class="hidden md:flex items-center ml-2 h-full">
                {links.map((l) => (
                    <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                       class="btn-plain scale-animation rounded-none h-10 font-bold text-md px-3 active:scale-95 flex items-center"
                    >
                        <div class="flex items-center">
                            {l.name}
                            {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] ml-1 opacity-20" />}
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <div class="flex items-center gap-1">
            <Search client:only="svelte"></Search>

            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>

            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-none w-11 h-11 flex items-center justify-center active:scale-90 md:!hidden p-0" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
    </div>

    <NavMenuPanel links={links}></NavMenuPanel>
</nav>

<style>
    #navbar {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
	}

	#navbar a, #navbar span {
    	font-family: var(--font-title) !important;
	}
</style>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

document.addEventListener('astro:page-load', loadButtonScript);
loadButtonScript();
</script>
