---
interface Link {
  imgurl: string
  title: string
  desc: string
  siteurl: string
}

interface LinkList {
  id_name: string
  link_list: Link[]
}

function shuffle(arr: Link[]) {
  return arr.sort(() => {
    return Math.random() - 0.5
  })
}

interface Props {
  title?: string
  list: LinkList
}
const { title, list: linkList, ...props } = Astro.props
---

{title && <h2 id={linkList.id_name}>{title}</h2>}
<div class='grid gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3' {...props}>
  {
    linkList.link_list.length > 0 ? (
      shuffle(linkList.link_list).map((lnk: Link) => (
        <a href={lnk.siteurl} target='_blank' class='no-underline'>
          {/* 外层卡片 */}
          <div class='group relative h-full overflow-hidden rounded-lg border bg-background transition-colors hover:bg-muted' style="font-family: var(--font-card);">
            
            {/* 布局容器：
                - p-2.5: 上下左右内边距缩小为 10px
                - gap-2.5: 头像与文字间距保持 10px（四周等距）
            */}
            <div class='relative z-10 flex items-center h-full p-2.5 gap-2.5'>
              
              {/* avatar (高度缩小至 4/5 左右: h-11 w-11 / 44px) */}
              <div class='relative h-11 w-11 min-w-11 overflow-hidden rounded-lg flex-shrink-0'>
                <img
                  class='my-0 bg-card h-full w-full object-cover'
                  src={lnk.imgurl}
                  alt='avatar'
                  loading='lazy'
                />
                <div class='absolute start-0 top-0 h-full w-full'>
                  <div class='flex h-full w-full items-center justify-center rounded-lg bg-foreground opacity-0 transition-opacity duration-300 ease-in-out group-hover:opacity-50'>
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      width='24'
                      height='24'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke-width='2.5'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      class='stroke-background'
                    >
                      <line
                        x1='5'
                        y1='12'
                        x2='19'
                        y2='12'
                        class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
                      />
                      <polyline
                        points='12 5 19 12 12 19'
                        class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
                      />
                    </svg>
                  </div>
                </div>
              </div>

              {/* details (间距与行高调整，保持紧凑) */}
              <div class='flex flex-col gap-y-0.5 min-w-0 flex-1 justify-center'>
                <p class='my-0 line-clamp-1 text-sm font-medium leading-snug'>{lnk.title}</p>
                <p class='my-0 line-clamp-1 text-xs text-muted-foreground leading-snug'>{lnk.desc}</p>
              </div>

            </div>
          </div>
        </a>
      ))
    ) : (
      <p>Nothing here.</p>
    )
  }
</div>

